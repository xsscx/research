+inline bool calculator_quality_work_within_budget(CIccProfile *pIcc,
+                                                  size_t evaluations) {
+  if (!pIcc || !evaluations) {
+    return false;
+  }
+
+  size_t remaining = kMaxCalculatorQualityWork / evaluations;
+  for (TagEntryList::iterator it = pIcc->m_Tags.begin();
+       it != pIcc->m_Tags.end(); ++it) {
+    CIccTagMultiProcessElement *mpe =
+        dynamic_cast<CIccTagMultiProcessElement *>(pIcc->FindTag(*it));
+    if (!mpe) {
+      continue;
+    }
+
+    const icUInt32Number count = mpe->NumElements();
+    for (icUInt32Number i = 0; i < count; ++i) {
+      CIccMpeCalculator *calc =
+          dynamic_cast<CIccMpeCalculator *>(mpe->GetElement((int)i));
+      if (!calc) {
+        continue;
+      }
+      const icUInt64Number cost = calc->GetEstimatedCost();
+      if (cost > remaining) {
+        return false;
+      }
+      remaining -= static_cast<size_t>(cost);
+    }
+  }
+  return true;
+}
