+++ b/IccProfLib/IccCAM.cpp
@@ -147,7 +147,13 @@ CIccCamConverter::H_FunctionInv (icFloatNumber	y)
 {
 	icFloatNumber	x;
 
-	x = (icFloatNumber) (pow (27.13*y / (400.0-y), 1.0/m_exp));
+	double denom = 400.0 - (double)y;
+	if (!std::isfinite((double)y) || !std::isfinite((double)m_exp) || m_exp == 0.0f ||
+	    !std::isfinite(denom) || denom == 0.0) {
+		return 0.0f;
+	}
+
+	x = (icFloatNumber) (pow (27.13*y / denom, 1.0/m_exp));
 
 	return x;
 }
