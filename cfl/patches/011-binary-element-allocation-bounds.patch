+# Bounds attacker-controlled binary child elements before allocation-bearing
+# readers consume them. The fixture also keeps a complete minimal CLUT as a
+# positive control for the exact-header rejection.
+if(TARGET "${TARGET_LIB_ICCPROFLIB}")
+  iccdev_add_regression_executable(iccBinaryElementAllocationBoundsTest
+    "${ICCDEV_REPO_ROOT}/.github/ci/regression/binary-element-allocation-bounds.cpp"
+  )
+  target_compile_features(iccBinaryElementAllocationBoundsTest PRIVATE cxx_std_17)
+  target_include_directories(iccBinaryElementAllocationBoundsTest PRIVATE
+    "${ICCDEV_REPO_ROOT}/IccProfLib"
+  )
+  target_link_libraries(iccBinaryElementAllocationBoundsTest PRIVATE ${TARGET_LIB_ICCPROFLIB})
+  add_dependencies(check iccBinaryElementAllocationBoundsTest)
+
+  add_test(
+    NAME iccdev.binary-element-allocation-bounds
+    COMMAND "$<TARGET_FILE:iccBinaryElementAllocationBoundsTest>"
+  )
+  set_tests_properties(iccdev.binary-element-allocation-bounds PROPERTIES
+    TIMEOUT 60
+    LABELS "iccdev;profile;parser;security;regression"
+  )
+  if(WIN32)
+    set(_binary_element_bounds_windows_env_mods
+      "PATH=path_list_prepend:$<TARGET_FILE_DIR:iccBinaryElementAllocationBoundsTest>"
+      "PATH=path_list_prepend:$<TARGET_FILE_DIR:${TARGET_LIB_ICCPROFLIB}>"
+    )
+    foreach(_runtime_path IN LISTS ICCDEV_WINDOWS_RUNTIME_PATHS)
+      list(APPEND _binary_element_bounds_windows_env_mods
+        "PATH=path_list_prepend:${_runtime_path}")
+    endforeach()
+    set_tests_properties(iccdev.binary-element-allocation-bounds PROPERTIES
+      ENVIRONMENT_MODIFICATION "${_binary_element_bounds_windows_env_mods}"
+    )
+  endif()
+endif()
