+// Regression: binary element readers must reject child extents that exceed the
+// enclosing element before their allocation-bearing readers are entered. An
+// exact-size CLUT header must likewise be rejected before zero remaining bytes
+// can be interpreted as Init()'s unbounded programmatic-allocation sentinel.
+
+#include "IccIO.h"
+#include "IccMpeBasic.h"
+#include "IccTagLut.h"
+
+#include <cstdio>
+
+#ifdef USEICCDEVNAMESPACE
+using namespace iccDEV;
+#endif
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool condition, const char *label)
+{
+  std::printf("%s: %s\n", condition ? "ok  " : "FAIL", label);
+  if (!condition)
+    g_failures++;
+}
+
+bool buildCurveSet(CIccMemIO &io)
+{
+  static const icUInt32Number kElementSize = 32;
+  if (!io.Alloc(kElementSize, true))
+    return false;
+
+  icUInt32Number value32 = icSigCurveSetElemType;
+  icUInt16Number value16 = 1;
+  if (!io.Write32(&value32))
+    return false;
+  value32 = 0;
+  if (!io.Write32(&value32) ||
+      !io.Write16(&value16) || !io.Write16(&value16))
+    return false;
+
+  value32 = 20;
+  if (!io.Write32(&value32))
+    return false;
+  value32 = 64;
+  if (!io.Write32(&value32))
+    return false;
+
+  value32 = icSigSegmentedCurve;
+  if (!io.Write32(&value32))
+    return false;
+  value32 = 0;
+  value16 = 0;
+  if (!io.Write32(&value32) ||
+      !io.Write16(&value16) || !io.Write16(&value16))
+    return false;
+
+  return io.Seek(0, icSeekSet) == 0;
+}
+
+bool buildClut(CIccMemIO &io, bool withData)
+{
+  static const icUInt32Number kHeaderSize = 20;
+  static const icUInt32Number kDataSize = 2u * 2u * 2u * 2u * 2u * 3u;
+  const icUInt32Number size = kHeaderSize + (withData ? kDataSize : 0u);
+  if (!io.Alloc(size, true))
+    return false;
+
+  icUInt8Number grids[16] = {2, 2, 2, 2, 2};
+  icUInt8Number precision = 1;
+  icUInt8Number reserved[3] = {};
+  if (io.Write8(grids, sizeof(grids)) != sizeof(grids) ||
+      !io.Write8(&precision) ||
+      io.Write8(reserved, sizeof(reserved)) != sizeof(reserved)) {
+    return false;
+  }
+
+  if (withData) {
+    icUInt8Number samples[kDataSize] = {};
+    if (io.Write8(samples, sizeof(samples)) != sizeof(samples))
+      return false;
+  }
+  return io.Seek(0, icSeekSet) == 0;
+}
+
+} // namespace
+
+int main()
+{
+  {
+    CIccMemIO io;
+    check(buildCurveSet(io), "curve-set fixture is built");
+    CIccMpeCurveSet curves;
+    check(!curves.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "curve-set child larger than its parent is rejected");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildClut(io, false), "header-only CLUT fixture is built");
+    CIccCLUT clut(5, 3);
+    check(!clut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "header-only CLUT is rejected");
+    check(clut.NumPoints() == 0,
+          "rejected header-only CLUT commits no point count");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildClut(io, true), "complete CLUT fixture is built");
+    CIccCLUT clut(5, 3);
+    check(clut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "complete minimal CLUT is accepted");
+    check(clut.NumPoints() == 32,
+          "complete minimal CLUT retains all grid points");
+  }
+
+  if (g_failures) {
+    std::printf("\n%d case(s) FAILED\n", g_failures);
+    return 1;
+  }
+  std::printf("\nall cases passed\n");
+  return 0;
+}
