+# Guards the profile-level tag-directory work bound. Untrusted tag counts feed
+# allocation, parsing, validation, and shared-tag association loops, so the
+# binary reader accepts exactly 1,000 entries and rejects the next value.
+function(iccdev_add_profile_tag_count_bound_test)
+  if(NOT TARGET "${TARGET_LIB_ICCPROFLIB}")
+    return()
+  endif()
+
+  iccdev_add_regression_executable(iccProfileTagCountBoundTest
+    "${ICCDEV_REPO_ROOT}/.github/ci/regression/profile-tag-count-bound.cpp"
+  )
+  target_compile_features(iccProfileTagCountBoundTest PRIVATE cxx_std_17)
+  target_include_directories(iccProfileTagCountBoundTest PRIVATE
+    "${ICCDEV_REPO_ROOT}/IccProfLib"
+  )
+  target_link_libraries(iccProfileTagCountBoundTest PRIVATE ${TARGET_LIB_ICCPROFLIB})
+  add_dependencies(check iccProfileTagCountBoundTest)
+
+  add_test(
+    NAME iccdev.profile-tag-count-bound
+    COMMAND "$<TARGET_FILE:iccProfileTagCountBoundTest>"
+  )
+  set_tests_properties(iccdev.profile-tag-count-bound PROPERTIES
+    TIMEOUT 60
+    LABELS "iccdev;profile;parser;security;regression"
+  )
+  if(WIN32)
+    set(_profile_tag_count_windows_env_mods
+      "PATH=path_list_prepend:$<TARGET_FILE_DIR:iccProfileTagCountBoundTest>"
+      "PATH=path_list_prepend:$<TARGET_FILE_DIR:${TARGET_LIB_ICCPROFLIB}>"
+    )
+    foreach(_runtime_path IN LISTS ICCDEV_WINDOWS_RUNTIME_PATHS)
+      list(APPEND _profile_tag_count_windows_env_mods
+        "PATH=path_list_prepend:${_runtime_path}")
+    endforeach()
+    set_tests_properties(iccdev.profile-tag-count-bound PROPERTIES
+      ENVIRONMENT_MODIFICATION "${_profile_tag_count_windows_env_mods}"
+    )
+  endif()
+endfunction()
