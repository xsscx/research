+// Regression: an untrusted profile could declare every physically representable
+// tag-directory entry. Callers that load or inspect each tag then multiplied
+// that count through parsing, validation, and shared-tag association loops.
+// Pin the library's documented 1,000-entry boundary at the binary read path.
+
+#include "IccProfile.h"
+
+#include <cstdio>
+#include <vector>
+
+#ifdef USEICCDEVNAMESPACE
+using namespace iccDEV;
+#endif
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool condition, const char *label)
+{
+  std::printf("%s: %s\n", condition ? "ok  " : "FAIL", label);
+  if (!condition)
+    g_failures++;
+}
+
+void put32(std::vector<icUInt8Number> &bytes, size_t offset,
+           icUInt32Number value)
+{
+  bytes[offset] = static_cast<icUInt8Number>(value >> 24);
+  bytes[offset + 1] = static_cast<icUInt8Number>(value >> 16);
+  bytes[offset + 2] = static_cast<icUInt8Number>(value >> 8);
+  bytes[offset + 3] = static_cast<icUInt8Number>(value);
+}
+
+std::vector<icUInt8Number> makeProfile(icUInt32Number tagCount)
+{
+  const size_t size = 132u + static_cast<size_t>(tagCount) * 12u;
+  std::vector<icUInt8Number> bytes(size, 0);
+  put32(bytes, 0, static_cast<icUInt32Number>(size));
+  put32(bytes, 8, icVersionNumberV4_3);
+  put32(bytes, 12, icSigDisplayClass);
+  put32(bytes, 16, icSigRgbData);
+  put32(bytes, 20, icSigXYZData);
+  put32(bytes, 36, icMagicNumber);
+  put32(bytes, 128, tagCount);
+  return bytes;
+}
+
+CIccProfile *openProfile(const std::vector<icUInt8Number> &bytes)
+{
+  return OpenIccProfile(bytes.data(),
+      static_cast<icUInt32Number>(bytes.size()), false);
+}
+
+} // namespace
+
+int main()
+{
+  std::vector<icUInt8Number> atLimit = makeProfile(1000);
+  CIccProfile *accepted = openProfile(atLimit);
+  check(accepted != NULL, "a profile with exactly 1,000 tags is accepted");
+  check(accepted && accepted->m_Tags.size() == 1000,
+        "the accepted directory retains all 1,000 entries");
+  delete accepted;
+
+  std::vector<icUInt8Number> overLimit = makeProfile(1001);
+  CIccProfile *rejected = openProfile(overLimit);
+  check(rejected == NULL, "a profile with 1,001 tags is rejected");
+  delete rejected;
+
+  if (g_failures) {
+    std::printf("\n%d case(s) FAILED\n", g_failures);
+    return 1;
+  }
+  std::printf("\nall cases passed\n");
+  return 0;
+}
