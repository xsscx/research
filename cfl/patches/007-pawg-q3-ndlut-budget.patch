+// Regression: PAWG Q3 sampled the neutral diagonal and every device axis of an
+// n-D LUT without accounting for CIccCLUT::InterpND's 2^N corner visits.  The
+// 14- and 15-channel CFL slow units therefore took seconds in iccPawgReport and
+// tens of seconds under sanitizer/coverage instrumentation.  Keep the 13-channel
+// side of the work limit and make a real 14-channel CMM stop before Apply().
+#include "IccProfile.h"
+#include "IccTagLut.h"
+
+#include "IccQualityMetrics.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <string>
+
+using namespace iccquality;
+
+static int g_failures = 0;
+
+static void check(bool condition, const char *message)
+{
+  std::printf("%s: %s\n", condition ? "ok  " : "FAIL", message);
+  if (!condition) {
+    ++g_failures;
+  }
+}
+
+static bool make_nd_lut_profile(CIccProfile &profile, int channels,
+                                icColorSpaceSignature colorSpace)
+{
+  profile.InitHeader();
+  profile.m_Header.version = icVersionNumberV4_3;
+  profile.m_Header.deviceClass = icSigOutputClass;
+  profile.m_Header.colorSpace = colorSpace;
+  profile.m_Header.pcs = icSigLabData;
+
+  CIccTagLutAtoB *lut = new CIccTagLutAtoB();
+  if (!lut->Init(static_cast<icUInt8Number>(channels), 3)) {
+    delete lut;
+    return false;
+  }
+  lut->SetColorSpaces(colorSpace, icSigLabData);
+
+  CIccCLUT *clut = lut->NewCLUT(2, 2);
+  if (!clut) {
+    delete lut;
+    return false;
+  }
+  icFloatNumber *data = clut->GetData(0);
+  std::fill(data, data + static_cast<size_t>(clut->NumPoints()) *
+      clut->GetOutputChannels(), 0.0f);
+
+  profile.AttachTag(icSigAToB0Tag, lut);
+  return true;
+}
+
+int main()
+{
+  check(nd_lut_smoothness_within_work_budget(13),
+        "13-channel n-D LUT remains inside the Q3 work budget");
+  check(!nd_lut_smoothness_within_work_budget(14),
+        "14-channel n-D LUT exceeds the Q3 work budget");
+  check(!nd_lut_smoothness_within_work_budget(15),
+        "15-channel n-D LUT exceeds the Q3 work budget");
+
+  CIccProfile profile;
+  check(make_nd_lut_profile(profile, 14, icSig14colorData),
+        "construct 14-channel n-D LUT control profile");
+
+  SmoothnessMetrics metrics;
+  std::string reason;
+  const bool measured = measure_transform_smoothness(&profile, metrics, reason);
+  check(!measured, "Q3 dispatcher refuses the 14-channel n-D LUT before sampling");
+  check(!metrics.measured, "refused Q3 metric is not marked measured");
+  check(reason.find("sample grid exceeds quality metric budget") != std::string::npos,
+        "Q3 refusal is classified as not applicable");
+
+  if (g_failures) {
+    std::printf("\n%d case(s) FAILED\n", g_failures);
+    return 1;
+  }
+  std::printf("\nall cases passed\n");
+  return 0;
+}
diff --git a/Tools/CmdLine/IccPawgReport/IccQualityMetrics.h b/Tools/CmdLine/IccPawgReport/IccQualityMetrics.h
index f108fe4..709a0ab 100644
--- a/Tools/CmdLine/IccPawgReport/IccQualityMetrics.h
+++ b/Tools/CmdLine/IccPawgReport/IccQualityMetrics.h
@@ -66,4 +66,12 @@ namespace iccquality {
 constexpr int kMaxQualityChannels = 16;
 constexpr size_t kMaxQualitySamples = 2000000;
+constexpr int kSmoothnessSamples = 65;
+
+// CIccXformNDLut uses multilinear interpolation, whose work grows as 2^N for
+// N input channels.  Q3 evaluates the neutral diagonal plus every device axis,
+// so 14- and 15-channel profiles otherwise require roughly 16 and 34 million
+// CLUT-corner visits.  Keep 13-channel profiles (about 7.5 million visits) in
+// scope while refusing the next exponential step (CWE-400).
+constexpr size_t kMaxSmoothnessInterpolationCorners = 8u * 1024u * 1024u;
 constexpr double kPi = 3.141592653589793238462643383279502884;
 constexpr double kDegToRad = kPi / 180.0;
@@ -620,4 +628,17 @@ inline bool is_lab_or_xyz_pcs(icColorSpaceSignature pcs) {
 }
 
+inline bool nd_lut_smoothness_within_work_budget(int deviceChannels,
+                                                 int samples = kSmoothnessSamples) {
+  if (deviceChannels < 1 || deviceChannels > kMaxQualityChannels || samples < 1) {
+    return false;
+  }
+
+  const size_t paths = deviceChannels == 1 ? 1u :
+      static_cast<size_t>(deviceChannels + 1);
+  const size_t cornersPerSample = size_t{1} << deviceChannels;
+  return cornersPerSample <=
+      kMaxSmoothnessInterpolationCorners / paths / static_cast<size_t>(samples);
+}
+
 inline bool status_ok(icStatusCMM status, const std::string &phase, std::string &reason) {
   if (status == icCmmStatOk) {
@@ -956,5 +977,12 @@ inline bool measure_cmm_forward_smoothness(CIccProfile *pIcc,
   }
 
-  constexpr int kSamples = 65;
+  const CIccXform *first = forward.GetFirstXform();
+  if (first && first->GetXformType() == icXformTypeNDLut &&
+      !nd_lut_smoothness_within_work_budget(deviceChannels)) {
+    reason = "CIccCmm smoothness sample grid exceeds quality metric budget "
+             "for n-D LUT interpolation";
+    return false;
+  }
+
   std::array<icFloatNumber, 16> device{};
   std::array<icFloatNumber, 16> pcsValue{};
@@ -970,6 +998,6 @@ inline bool measure_cmm_forward_smoothness(CIccProfile *pIcc,
     double prevStep = -1.0;
 
-    for (int i = 0; i < kSamples; ++i) {
-      const double v = i / static_cast<double>(kSamples - 1);
+    for (int i = 0; i < kSmoothnessSamples; ++i) {
+      const double v = i / static_cast<double>(kSmoothnessSamples - 1);
       device.fill(0.0f);
 
@@ -1640,5 +1668,11 @@ inline bool measure_transform_smoothness(CIccProfile *pIcc,
   }
 
-  if (reason.empty()) {
+  // A general AToB tag is first rejected by the classic-lut8/lut16 probe.  If
+  // its real CMM path then reaches the resource budget, preserve that terminal
+  // reason so the report classifies Q3 as not applicable instead of a gap.
+  if (cmmReason.find("sample grid exceeds quality metric budget") !=
+      std::string::npos) {
+    reason = cmmReason;
+  } else if (reason.empty()) {
     reason = !cmmReason.empty() ? cmmReason : matrixReason;
   }
