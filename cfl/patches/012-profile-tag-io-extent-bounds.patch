+// Regression: GetTagIO() must validate a tag-directory extent against the
+// attached input before allocating a buffer or moving the shared IO cursor.
+
+#include "IccIO.h"
+#include "IccProfile.h"
+
+#include <cstdio>
+#include <memory>
+
+#ifdef USEICCDEVNAMESPACE
+using namespace iccDEV;
+#endif
+
+namespace {
+
+const icTagSignature kTestTag =
+    static_cast<icTagSignature>(0x74657374u);
+int g_failures = 0;
+
+void check(bool condition, const char *label)
+{
+  std::printf("%s: %s\n", condition ? "ok  " : "FAIL", label);
+  if (!condition)
+    g_failures++;
+}
+
+bool buildProfile(CIccMemIO &io, icUInt32Number offset,
+                  icUInt32Number size)
+{
+  static const icUInt32Number kProfileSize = 148;
+  if (!io.Alloc(kProfileSize, true) || io.Seek(36, icSeekSet) != 36)
+    return false;
+
+  icUInt32Number value = icMagicNumber;
+  if (!io.Write32(&value) || io.Seek(128, icSeekSet) != 128)
+    return false;
+
+  value = 1;
+  if (!io.Write32(&value))
+    return false;
+  value = kTestTag;
+  if (!io.Write32(&value))
+    return false;
+  value = offset;
+  if (!io.Write32(&value))
+    return false;
+  value = size;
+  if (!io.Write32(&value) || io.Seek(144, icSeekSet) != 144)
+    return false;
+
+  value = 0x12345678u;
+  return io.Write32(&value) && io.Seek(0, icSeekSet) == 0;
+}
+
+std::unique_ptr<CIccProfile> attachProfile(CIccMemIO &storage,
+                                           CIccMemIO *&attached)
+{
+  attached = new CIccMemIO;
+  if (!attached->Attach(storage.GetData(), storage.GetLength(), false)) {
+    delete attached;
+    attached = nullptr;
+    return nullptr;
+  }
+
+  std::unique_ptr<CIccProfile> profile(new CIccProfile);
+  if (!profile->Attach(attached, false)) {
+    profile.reset();
+    delete attached;
+    attached = nullptr;
+  }
+  return profile;
+}
+
+} // namespace
+
+int main()
+{
+  {
+    CIccMemIO storage;
+    check(buildProfile(storage, 144, 4096),
+          "oversized tag-extent fixture is built");
+    CIccMemIO *attached = nullptr;
+    std::unique_ptr<CIccProfile> profile = attachProfile(storage, attached);
+    check(profile.get() != nullptr, "oversized tag-extent profile is attached");
+    if (profile && attached) {
+      const icInt64Number before = attached->Tell();
+      std::unique_ptr<CIccMemIO> tagIo(profile->GetTagIO(kTestTag));
+      check(!tagIo, "tag extent larger than attached input is rejected");
+      check(attached->Tell() == before,
+            "oversized tag extent is rejected before allocation or seek");
+    }
+  }
+
+  {
+    CIccMemIO storage;
+    check(buildProfile(storage, 36, 4),
+          "header-overlap tag-extent fixture is built");
+    CIccMemIO *attached = nullptr;
+    std::unique_ptr<CIccProfile> profile = attachProfile(storage, attached);
+    check(profile.get() != nullptr, "header-overlap profile is attached");
+    if (profile) {
+      std::unique_ptr<CIccMemIO> tagIo(profile->GetTagIO(kTestTag));
+      check(!tagIo, "tag extent overlapping the profile header is rejected");
+    }
+  }
+
+  {
+    CIccMemIO storage;
+    check(buildProfile(storage, 144, 4), "valid tag-extent fixture is built");
+    CIccMemIO *attached = nullptr;
+    std::unique_ptr<CIccProfile> profile = attachProfile(storage, attached);
+    check(profile.get() != nullptr, "valid tag-extent profile is attached");
+    if (profile) {
+      std::unique_ptr<CIccMemIO> tagIo(profile->GetTagIO(kTestTag));
+      check(tagIo && tagIo->GetLength() == 4,
+            "valid tag extent remains readable");
+    }
+  }
+
+  if (g_failures) {
+    std::printf("\n%d case(s) FAILED\n", g_failures);
+    return 1;
+  }
+  std::printf("\nall cases passed\n");
+  return 0;
+}
