+# GetTagIO() exposes raw serialized tag bytes to API consumers. Keep malformed
+# directory extents from becoming allocation sizes before that copy begins.
+if(TARGET "${TARGET_LIB_ICCPROFLIB}")
+  iccdev_add_regression_executable(iccProfileTagIoExtentBoundsTest
+    "${ICCDEV_REPO_ROOT}/.github/ci/regression/profile-tag-io-extent-bounds.cpp"
+  )
+  target_compile_features(iccProfileTagIoExtentBoundsTest PRIVATE cxx_std_17)
+  target_include_directories(iccProfileTagIoExtentBoundsTest PRIVATE
+    "${ICCDEV_REPO_ROOT}/IccProfLib"
+  )
+  target_link_libraries(iccProfileTagIoExtentBoundsTest PRIVATE ${TARGET_LIB_ICCPROFLIB})
+  add_dependencies(check iccProfileTagIoExtentBoundsTest)
+
+  add_test(
+    NAME iccdev.profile-tag-io-extent-bounds
+    COMMAND "$<TARGET_FILE:iccProfileTagIoExtentBoundsTest>"
+  )
+  set_tests_properties(iccdev.profile-tag-io-extent-bounds PROPERTIES
+    TIMEOUT 60
+    LABELS "iccdev;profile;api;security;regression"
+  )
+  if(WIN32)
+    set(_profile_tag_io_bounds_windows_env_mods
+      "PATH=path_list_prepend:$<TARGET_FILE_DIR:iccProfileTagIoExtentBoundsTest>"
+      "PATH=path_list_prepend:$<TARGET_FILE_DIR:${TARGET_LIB_ICCPROFLIB}>"
+    )
+    foreach(_runtime_path IN LISTS ICCDEV_WINDOWS_RUNTIME_PATHS)
+      list(APPEND _profile_tag_io_bounds_windows_env_mods
+        "PATH=path_list_prepend:${_runtime_path}")
+    endforeach()
+    set_tests_properties(iccdev.profile-tag-io-extent-bounds PROPERTIES
+      ENVIRONMENT_MODIFICATION "${_profile_tag_io_bounds_windows_env_mods}"
+    )
+  endif()
+endif()
