--- a/IccProfLib/IccTagLut.cpp
+++ b/IccProfLib/IccTagLut.cpp
@@ -2164,6 +2164,15 @@ bool CIccCLUT::Init(const icUInt8Number *pGridPoints, icUInt32Number nMaxSize, i
       return false;
   }
 
+  // The loop is skipped for a one-dimensional CLUT. Apply the serialized
+  // payload bound once more after dimension accumulation so 1-D readers cannot
+  // allocate from grid and output counts that exceed their encoded data.
+  if (nMaxSize &&
