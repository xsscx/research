@@ -16540,6 +16540,42 @@ iccdev_add_script_test(
   "${ICCDEV_REPO_ROOT}/.github/scripts/iccdev-issue-2011-hdr-cicp-transfer-regression.sh"
 )
 
+# Bounds serialized CLUT allocations to their encoded payloads while keeping
+# the public zero-limit programmatic construction mode unchanged.
+if(TARGET "${TARGET_LIB_ICCPROFLIB}")
+  iccdev_add_regression_executable(iccSerializedClutAllocationBoundsTest
+    "${ICCDEV_REPO_ROOT}/.github/ci/regression/serialized-clut-allocation-bounds.cpp"
+  )
+  target_compile_features(iccSerializedClutAllocationBoundsTest PRIVATE cxx_std_17)
+  target_include_directories(iccSerializedClutAllocationBoundsTest PRIVATE
+    "${ICCDEV_REPO_ROOT}/IccProfLib"
+  )
+  target_link_libraries(iccSerializedClutAllocationBoundsTest PRIVATE ${TARGET_LIB_ICCPROFLIB})
+  add_dependencies(check iccSerializedClutAllocationBoundsTest)
+
+  add_test(
+    NAME iccdev.serialized-clut-allocation-bounds
+    COMMAND "$<TARGET_FILE:iccSerializedClutAllocationBoundsTest>"
+  )
+  set_tests_properties(iccdev.serialized-clut-allocation-bounds PROPERTIES
+    TIMEOUT 60
+    LABELS "iccdev;profile;parser;security;regression"
+  )
+  if(WIN32)
+    set(_serialized_clut_bounds_windows_env_mods
+      "PATH=path_list_prepend:$<TARGET_FILE_DIR:iccSerializedClutAllocationBoundsTest>"
+      "PATH=path_list_prepend:$<TARGET_FILE_DIR:${TARGET_LIB_ICCPROFLIB}>"
+    )
+    foreach(_runtime_path IN LISTS ICCDEV_WINDOWS_RUNTIME_PATHS)
+      list(APPEND _serialized_clut_bounds_windows_env_mods
+        "PATH=path_list_prepend:${_runtime_path}")
+    endforeach()
+    set_tests_properties(iccdev.serialized-clut-allocation-bounds PROPERTIES
+      ENVIRONMENT_MODIFICATION "${_serialized_clut_bounds_windows_env_mods}"
+    )
+  endif()
+endif()
