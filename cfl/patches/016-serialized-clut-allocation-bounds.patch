--- a/IccProfLib/IccMpeBasic.cpp
+++ b/IccProfLib/IccMpeBasic.cpp
@@ -6279,7 +6279,11 @@ bool CIccMpeCLUT::Read(icUInt32Number size, CIccIO *pIO)
   // because Init() leaves m_pData NULL and GetData(0) is &m_pData[0]. State the
   // rejection where it happens instead of relying on that; CIccMpeExtCLUT::Read
   // further down this file already does.
-  if (!m_pCLUT->Init(gridPoints))
+  // This is a serialized float32 CLUT, so bind the grid allocation to the
+  // bytes that remain in the element.  The no-limit overload is reserved for
+  // programmatic CLUT construction and can allocate from hostile grid counts
+  // before the short payload is rejected below.
+  if (!m_pCLUT->Init(gridPoints, dataSize, sizeof(icFloat32Number)))
     return false;
 
   icFloatNumber *pData = m_pCLUT->GetData(0);
