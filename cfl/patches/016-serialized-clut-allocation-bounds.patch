+// Regression: serialized CLUT readers must bind grid allocation to the encoded
+// payload. A zero byte limit is reserved for programmatic construction.
+
+#include "IccIO.h"
+#include "IccMpeBasic.h"
+#include "IccMpeSpectral.h"
+#include "IccTagLut.h"
+
+#include <cstdio>
+
+#ifdef USEICCDEVNAMESPACE
+using namespace iccDEV;
+#endif
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool condition, const char *label)
+{
+  std::printf("%s: %s\n", condition ? "ok  " : "FAIL", label);
+  if (!condition)
+    g_failures++;
+}
+
+bool buildMpeClut(CIccMemIO &io, bool complete)
+{
+  static const icUInt32Number kHeaderSize = 28;
+  static const icUInt32Number kDataSize = 2u * sizeof(icFloat32Number);
+  if (!io.Alloc(kHeaderSize + kDataSize, true))
+    return false;
+
+  icUInt32Number value32 = icSigCLutElemType;
+  icUInt16Number value16 = complete ? 1 : 2;
+  if (!io.Write32(&value32))
+    return false;
+  value32 = 0;
+  if (!io.Write32(&value32) || !io.Write16(&value16))
+    return false;
+  value16 = 1;
+  if (!io.Write16(&value16))
+    return false;
+
+  icUInt8Number grids[16] = {};
+  grids[0] = complete ? 2 : 255;
+  grids[1] = complete ? 0 : 255;
+  if (io.Write8(grids, sizeof(grids)) != sizeof(grids))
+    return false;
+
+  icFloatNumber samples[2] = {};
+  if (io.WriteFloat32Float(samples, 2) != 2)
+    return false;
+
+  return io.Seek(0, icSeekSet) == 0;
+}
+
+bool buildSpectralClut(CIccMemIO &io, icElemTypeSignature signature,
+                       bool complete)
+{
+  static const icUInt32Number kHeaderSize = 40;
+  static const icUInt32Number kDataSize = 9;
+  const icUInt32Number size = kHeaderSize + (complete ? kDataSize : 0u);
+  if (!io.Alloc(size, true))
+    return false;
+
+  icUInt32Number value32 = signature;
+  icUInt16Number value16 = 1;
+  if (!io.Write32(&value32))
+    return false;
+  value32 = 0;
+  if (!io.Write32(&value32) || !io.Write16(&value16))
+    return false;
+  value16 = 3;
+  if (!io.Write16(&value16) || !io.Write32(&value32))
+    return false;
+
+  value16 = 0;
+  if (!io.Write16(&value16))
+    return false;
+  value16 = 1;
+  if (!io.Write16(&value16))
+    return false;
+  value16 = 3;
+  if (!io.Write16(&value16))
+    return false;
+  value16 = icValueTypeUInt8;
+  if (!io.Write16(&value16))
+    return false;
+
+  icUInt8Number grids[16] = {2};
+  if (io.Write8(grids, sizeof(grids)) != sizeof(grids))
+    return false;
+
+  if (complete) {
+    icUInt8Number samples[kDataSize] = {};
+    if (io.Write8(samples, sizeof(samples)) != sizeof(samples))
+      return false;
+  }
+
+  return io.Seek(0, icSeekSet) == 0;
+}
+
+bool buildLut8(CIccMemIO &io, bool complete)
+{
+  static const icUInt32Number kHeaderSize = 52;
+  static const icUInt32Number kInputCurveSize = 256;
+  static const icUInt32Number kClutSize = 2;
+  static const icUInt32Number kOutputCurveSize = 256;
+  const icUInt32Number size = kHeaderSize + kInputCurveSize +
+      (complete ? kClutSize + kOutputCurveSize : 0u);
+  if (!io.Alloc(size, true))
+    return false;
+
+  icUInt32Number value32 = icSigLut8Type;
+  if (!io.Write32(&value32))
+    return false;
+  value32 = 0;
+  if (!io.Write32(&value32))
+    return false;
+
+  icUInt8Number one = 1;
+  icUInt8Number grid = complete ? 2 : 255;
+  icUInt8Number zero = 0;
+  if (!io.Write8(&one) || !io.Write8(&one) ||
+      !io.Write8(&grid) || !io.Write8(&zero)) {
+    return false;
+  }
+
+  icUInt32Number matrix[9] = {};
+  if (io.Write32(matrix, 9) != 9)
+    return false;
+
+  icUInt8Number inputCurve[kInputCurveSize] = {};
+  if (io.Write8(inputCurve, sizeof(inputCurve)) != sizeof(inputCurve))
+    return false;
+
+  if (complete) {
+    icUInt8Number clut[kClutSize] = {};
+    icUInt8Number outputCurve[kOutputCurveSize] = {};
+    if (io.Write8(clut, sizeof(clut)) != sizeof(clut) ||
+        io.Write8(outputCurve, sizeof(outputCurve)) != sizeof(outputCurve)) {
+      return false;
+    }
+  }
+
+  return io.Seek(0, icSeekSet) == 0;
+}
+
+bool buildLut16(CIccMemIO &io, bool complete)
+{
+  static const icUInt32Number kHeaderSize = 56;
+  static const icUInt32Number kCurveEntries = 2;
+  static const icUInt32Number kClutEntries = 2;
+  const icUInt32Number dataEntries = kCurveEntries +
+      (complete ? kClutEntries + kCurveEntries : 0u);
+  if (!io.Alloc(kHeaderSize + dataEntries * sizeof(icUInt16Number), true))
+    return false;
+
+  icUInt32Number value32 = icSigLut16Type;
+  if (!io.Write32(&value32))
+    return false;
+  value32 = 0;
+  if (!io.Write32(&value32))
+    return false;
+
+  icUInt8Number one = 1;
+  icUInt8Number grid = complete ? 2 : 255;
+  icUInt8Number zero = 0;
+  if (!io.Write8(&one) || !io.Write8(&one) ||
+      !io.Write8(&grid) || !io.Write8(&zero)) {
+    return false;
+  }
+
+  icUInt32Number matrix[9] = {};
+  if (io.Write32(matrix, 9) != 9)
+    return false;
+
+  icUInt16Number entries = kCurveEntries;
+  if (!io.Write16(&entries) || !io.Write16(&entries))
+    return false;
+
+  icUInt16Number data[kCurveEntries + kClutEntries + kCurveEntries] = {};
+  if (io.Write16(data, dataEntries) != dataEntries)
+    return false;
+
+  return io.Seek(0, icSeekSet) == 0;
+}
+
+} // namespace
+
+int main()
+{
+  {
+    icUInt8Number grids[16] = {2};
+    CIccCLUT clut(1, 1);
+    check(clut.Init(grids),
+          "programmatic CLUT keeps the public zero-limit mode");
+    check(clut.NumPoints() == 2,
+          "programmatic CLUT retains all grid points");
+  }
+
+  {
+    icUInt8Number grids[16] = {255};
+    CIccCLUT clut(1, 65535);
+    check(!clut.Init(grids, 1, 1),
+          "one-dimensional CLUT larger than its payload is rejected");
+    check(clut.NumPoints() == 0,
+          "rejected one-dimensional CLUT commits no point count");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildMpeClut(io, false), "short MPE CLUT fixture is built");
+    CIccMpeCLUT clut;
+    check(!clut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "MPE CLUT larger than its payload is rejected");
+    check(clut.GetCLUT() && clut.GetCLUT()->NumPoints() == 0,
+          "rejected MPE CLUT commits no point count");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildMpeClut(io, true), "complete MPE CLUT fixture is built");
+    CIccMpeCLUT clut;
+    check(clut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "complete MPE CLUT is accepted");
+    check(clut.GetCLUT() && clut.GetCLUT()->NumPoints() == 2,
+          "complete MPE CLUT retains all grid points");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildSpectralClut(io, icSigEmissionCLUTElemType, false),
+          "header-only emission CLUT fixture is built");
+    CIccMpeEmissionCLUT clut;
+    check(!clut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "header-only emission CLUT is rejected");
+    check(!clut.GetCLUT(),
+          "rejected emission CLUT performs no grid allocation");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildSpectralClut(io, icSigReflectanceCLUTElemType, false),
+          "header-only reflectance CLUT fixture is built");
+    CIccMpeReflectanceCLUT clut;
+    check(!clut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "header-only reflectance CLUT is rejected");
+    check(!clut.GetCLUT(),
+          "rejected reflectance CLUT performs no grid allocation");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildSpectralClut(io, icSigEmissionCLUTElemType, true),
+          "complete emission CLUT fixture is built");
+    CIccMpeEmissionCLUT clut;
+    check(clut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "complete emission CLUT is accepted");
+    check(clut.GetCLUT() && clut.GetCLUT()->NumPoints() == 2,
+          "complete emission CLUT retains all grid points");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildLut8(io, false), "zero-CLUT Lut8 fixture is built");
+    CIccTagLut8 lut;
+    check(!lut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "Lut8 with no CLUT payload is rejected");
+    check(lut.GetCLUT() && lut.GetCLUT()->NumPoints() == 0,
+          "rejected Lut8 commits no point count");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildLut8(io, true), "complete Lut8 fixture is built");
+    CIccTagLut8 lut;
+    check(lut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "complete Lut8 is accepted");
+    check(lut.GetCLUT() && lut.GetCLUT()->NumPoints() == 2,
+          "complete Lut8 retains all grid points");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildLut16(io, false), "zero-CLUT Lut16 fixture is built");
+    CIccTagLut16 lut;
+    check(!lut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "Lut16 with no CLUT payload is rejected");
+    check(lut.GetCLUT() && lut.GetCLUT()->NumPoints() == 0,
+          "rejected Lut16 commits no point count");
+  }
+
+  {
+    CIccMemIO io;
+    check(buildLut16(io, true), "complete Lut16 fixture is built");
+    CIccTagLut16 lut;
+    check(lut.Read(static_cast<icUInt32Number>(io.GetLength()), &io),
+          "complete Lut16 is accepted");
+    check(lut.GetCLUT() && lut.GetCLUT()->NumPoints() == 2,
+          "complete Lut16 retains all grid points");
+  }
+
+  if (g_failures) {
+    std::printf("\n%d case(s) FAILED\n", g_failures);
+    return 1;
+  }
+  std::printf("\nall cases passed\n");
+  return 0;
+}
diff --git a/Build/Cmake/Testing/CMakeLists.txt b/Build/Cmake/Testing/CMakeLists.txt
