+static FILE* icOpenWriteBinaryFile(const char* szFname);
+
+static std::string SanitizeConsoleText(const char* szText)
+{
+  static const char hex[] = "0123456789ABCDEF";
+  std::string result;
+
+  if (!szText)
+    return result;
+
+  for (const unsigned char *p = (const unsigned char*)szText; *p; p++) {
+    unsigned char ch = *p;
+
+    switch (ch) {
+    case '\n':
+      result += "\\n";
+      break;
+    case '\r':
+      result += "\\r";
+      break;
+    case '\t':
+      result += "\\t";
+      break;
+    default:
+      if (ch < 0x20 || ch == 0x7f || (ch >= 0x80 && ch <= 0x9f)) {
+        result += "\\x";
+        result += hex[(ch >> 4) & 0xf];
+        result += hex[ch & 0xf];
+      }
+      else {
+        result += (char)ch;
+      }
+      break;
+    }
+  }
+
+  return result;
+}
+
+static std::string SanitizeConsoleText(const std::string& text)
+{
+  return SanitizeConsoleText(text.c_str());
+}
+
+static bool WriteEmbeddedIccProfile(const char* szFname, const unsigned char *pProfMem, unsigned int nLen)
+{
+  if (!pProfMem || !nLen)
+    return false;
+
+  FILE *fp = icOpenWriteBinaryFile(szFname);
+  if (!fp)
+    return false;
+
+  bool failed = (fwrite(pProfMem, 1, nLen, fp) != nLen);
+  (void)fclose(fp);
+
+  return !failed;
+}
