  "if" -> "is_array";
  "if" -> "size";
  "FuzzDataEntry" -> "fromJson";
  "FuzzDataEntry" -> "toJson";
  "switch" -> "CIccCfgDataApply";
  "if" -> "FuzzDataApply";
  "if" -> "FuzzImageApply";
  "if" -> "FuzzSearchApply";
}