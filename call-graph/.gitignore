# All generated artifacts (regenerate with scripts/)
# Keep only: scripts/*.py, README.md, viewer/index.html, mermaid/*.md
#
# Regenerate:
#   python3 scripts/generate-callgraphs.py        # DOT + SVG + AST JSON
#   python3 scripts/improve-callgraphs.py          # demangle + filter SVGs
#   python3 scripts/build-knowledge-graph.py       # knowledge-graph.json
#   python3 scripts/generate-mermaid.py all        # mermaid/*.md (committed)
#   python3 scripts/query-graph.py stats           # query the graph

# Call graphs (LLVM IR DOT + SVG + JSON renderings)
**/*-callgraph.dot
**/*-callgraph.svg
**/*-callgraph.json
**/*-callgraph-enriched.dot
**/*-callgraph-enriched.svg

# AST metadata
**/*-ast.json
**/*-summary.json

# Master indices (generated by scripts)
index.json
# knowledge-graph.json is tracked -- required by Dockerfile and MCP graph tools
!knowledge-graph.json
viewer/knowledge-graph.json

# LLVM IR intermediates
**/*.ll

# Compilation errors
**/*-errors.txt

# Archived demo branch
demo-rit/

# Python cache
__pycache__/
scripts/__pycache__/
