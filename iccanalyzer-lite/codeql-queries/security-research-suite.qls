# CodeQL Query Suite for Security Research
# Purpose: Comprehensive vulnerability detection for exploit development defense

- description: Security research query suite for iccLibFuzzer
- qlpack: codeql/cpp-queries

# Memory safety vulnerabilities
- queries: .
  from: codeql/cpp-queries
  include:
    kind:
      - problem
      - path-problem
    tags contain:
      - security

# Custom security research queries
- query: ./enum-undefined-behavior.ql
- query: ./buffer-overflow.ql
- query: ./type-confusion.ql
- query: ./use-after-free.ql
- query: ./integer-overflow-allocation.ql
- query: ./integer-overflow-multiply.ql
- query: ./alloc-dealloc-mismatch.ql
- query: ./unchecked-io-return.ql
- query: ./injection-attacks.ql
- query: ./xml-all-attacks.ql
- query: ./xml-external-entity-attacks.ql
- query: ./iccanalyzer-security.ql
- query: ./iccdumpprofile-enum-reachability.ql
- query: ./all-tools-enum-reachability.ql
- query: ./argv-output-path.ql
- query: ./null-pointer-deref.ql
- query: ./uninitialized-read.ql
- query: ./unsafe-array-new.ql
- query: ./unsafe-scalar-new.ql
- query: ./unaligned-pointer-cast.ql
- query: ./signed-shift-overflow.ql
- query: ./icc-tag-cstyle-cast.ql

# iccDEV library-specific queries (H154-H159 heuristic counterparts)
- query: ./iccdev-read-allocation-overflow.ql
- query: ./iccdev-clut-dimension-overflow.ql
- query: ./iccdev-unchecked-alloc-read.ql
- query: ./iccdev-tag-alloc-dealloc-mismatch.ql
- query: ./iccdev-file-controlled-enum-cast.ql
- query: ./iccdev-tag-ownership-uaf.ql

# Maintainer queries (CFL-048 through CFL-057 patterns)
- query: ./iccdev-describe-param-bounds.ql
- query: ./iccdev-describe-null-array.ql
- query: ./iccdev-format-specifier.ql
- query: ./iccdev-signed-unsigned-format.ql
- query: ./iccdev-uninitialized-constructor.ql
- query: ./iccdev-wrong-variable-index.ql
- query: ./iccdev-dumplut-missing-arg.ql

# Built-in security queries
- queries: .
  from: codeql/cpp-queries
  include:
    id:
      - cpp/integer-overflow
      - cpp/signed-overflow
      - cpp/uncontrolled-allocation-size
      - cpp/unbounded-write
      - cpp/pointer-overflow-check
      - cpp/bad-allocation-size
      - cpp/dangerous-function-overflow
      - cpp/wrong-type-format-argument
      - cpp/tainted-format-string
      - cpp/unsafe-strcat
      - cpp/unsafe-strncat
      - cpp/potentially-dangerous-function
      - cpp/memory-may-not-be-freed
      - cpp/memory-never-freed
      - cpp/double-free
      - cpp/use-after-free
      - cpp/delete-void-pointer
      - cpp/incorrect-allocation-error-handling
      - cpp/offset-use-before-range-check
      - cpp/upcast-array-pointer-arithmetic
      - cpp/unsafe-use-of-this
      - cpp/return-stack-allocated-memory
      - cpp/stack-address-escape

# Experimental security queries
- queries: .
  from: codeql/cpp-queries
  include:
    tags contain:
      - security
      - experimental

# Cross-container size mismatch (CFL-035 pattern)
- query: ./cross-container-oob.ql
