digraph iccDumpProfile {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#f0f4ff",
        fontname="Courier", fontsize=9];
  edge [color="#4a6fa5", arrowsize=0.7];

  "main" [label="int main()", fillcolor="#d4edda"];
  "EvaluateProfile" [label="EvaluateProfile", fillcolor="#fff3cd", style="rounded,filled,dashed"];
  "GetMean1" [label="GetMean1", fillcolor="#fff3cd", style="rounded,filled,dashed"];
  "GetMean2" [label="GetMean2", fillcolor="#fff3cd", style="rounded,filled,dashed"];
  "GetRenderingIntentName" [label="GetRenderingIntentName", fillcolor="#fff3cd", style="rounded,filled,dashed"];
  "atoi" [label="atoi", fillcolor="#fff3cd", style="rounded,filled,dashed"];
  "printf" [label="printf", fillcolor="#fff3cd", style="rounded,filled,dashed"];

  "main" -> "printf" [label="  L152  [gate: argc <= 1]  ", fontsize=7];
  "main" -> "atoi" [label="  L0  [gate: argc > 2]  ", fontsize=7];
  "main" -> "EvaluateProfile" [label="  L0  ", fontsize=7];
  "main" -> "GetRenderingIntentName" [label="  L0  ", fontsize=7];
  "main" -> "GetMean1" [label="  L0  ", fontsize=7];
  "main" -> "GetMean2" [label="  L0  ", fontsize=7];
}
