  "main" -> "strcasecmp" [label="  L34  ", fontsize=7];
  "main" -> "strncmp" [label="  L0  [else: !strcasecmp(...)]  ", fontsize=7];
  "main" -> "substr" [label="  L0  [else: !strcasecmp(...)]  ", fontsize=7];
