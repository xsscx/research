{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y", "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--chromeArg", "--no-sandbox",
        "--chromeArg", "--disable-gpu"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CI": "1"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "iccdev": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "ghcr.io/internationalcolorconsortium/iccdev-mcp:latest",
        "mcp"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "/home/xss/work/copilot/bin/github-mcp-docker",
      "args": []
    }
  }
}
