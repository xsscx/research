{
  "mcpServers": {
    "icc-profile-mcp": {
      "type": "stdio",
      "command": "python",
      "args": ["mcp-server/launch.py", "mcp"],
      "env": {
        "ICC_MCP_ROOT": "${workspaceFolder}"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y", "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--chromeArg", "--no-sandbox",
        "--chromeArg", "--disable-gpu"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CI": "1"
      }
    }
  }
}
