# Keep iccanalyzer-lite/iccDEV in the build context.
# The MCP image builds analyzers and safe XML tools against the repo's
# unpatched upstream checkout.
iccanalyzer-lite/iccDEV/Build/*
!iccanalyzer-lite/iccDEV/Build/Cmake/
!iccanalyzer-lite/iccDEV/Build/Cmake/**
!iccanalyzer-lite/iccDEV/Build/XCode/
!iccanalyzer-lite/iccDEV/Build/XCode/**

# Exclude fuzzer corpora and artifacts (huge)
cfl/corpus*
cfl/oom-*
cfl/crash-*
cfl/bin/
cfl/iccDEV/
cfl/nohup.out
cfl/profraw/
cfl/default.profraw
cfl/findings/

# Git and CI artifacts
.git
.github/codeql-databases
*.profraw
*.profdata
*.gcda
*.gcno

# Build artifacts
build/
iccanalyzer-lite/icctest/build/
*.o

# Python/test caches
**/__pycache__/
**/.pytest_cache/
*.pyc
