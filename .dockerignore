# Clone fresh upstream iccDEV inside the MCP Docker build.
# The top-level repo does not track these nested working trees, and sending
# local clones/build products in the context causes false-positive local builds.
iccanalyzer-lite/iccDEV/
colorbleed_tools/iccDEV/
colorbleed_tools/bin/
colorbleed_tools/iccToXml_unsafe
colorbleed_tools/iccFromXml_unsafe
colorbleed_tools/iccDumpAll

# Exclude fuzzer corpora and artifacts (huge)
cfl/corpus*
cfl/oom-*
cfl/crash-*
cfl/bin/
cfl/iccDEV/
cfl/nohup.out
cfl/profraw/
cfl/default.profraw
cfl/findings/

# Git and CI artifacts
.git
.github/codeql-databases
*.profraw
*.profdata
*.gcda
*.gcno

# Build artifacts
build/
iccanalyzer-lite/icctest/build/
*.o

# Python/test caches
**/__pycache__/
**/.pytest_cache/
*.pyc
