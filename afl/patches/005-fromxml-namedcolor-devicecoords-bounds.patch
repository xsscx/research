                 }
               }
               else if (!strcmp(szDeviceEncoding, "int16")) {
                 CIccUInt16Array coords;
 
                 coords.ParseArray(pNode->children);
                 icUInt16Number *pBuf = coords.GetBuf();
 
                 // CWE-400/CWE-834: clamp the field to the same load-time bound as
